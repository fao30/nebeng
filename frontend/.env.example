# URL backend Go (tanpa slash di akhir)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Peta AMap internasional (mapsplatform.opnavi.com). Kosongkan untuk memakai OpenStreetMap.
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
# sg (Singapura, default) atau de (Jerman)
NEXT_PUBLIC_AMAP_REGION=sg

# MapTiler (peta + pencarian alamat). Diprioritaskan di atas AMap bila diisi.
NEXT_PUBLIC_MAPTILER_KEY=
# NEXT_PUBLIC_MAPTILER_STYLE=streets-v4
